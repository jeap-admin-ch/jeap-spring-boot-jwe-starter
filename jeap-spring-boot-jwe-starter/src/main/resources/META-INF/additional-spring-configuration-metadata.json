{
  "properties": [
    {
      "name": "jeap.jwe.jwks.path",
      "defaultValue": "/.well-known/jwks.json"
    },
    {
      "name": "jeap.jwe.metadata.path",
      "defaultValue": "/.well-known/jwe-configuration"
    },
    {
