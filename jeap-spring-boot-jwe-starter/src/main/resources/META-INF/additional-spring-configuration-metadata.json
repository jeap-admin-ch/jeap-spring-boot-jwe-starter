      "defaultValue": [
        "/*api*/**"
      ]
    },
    {
      "name": "jeap.jwe.filter.content-type-allowlist",
      "defaultValue": [
        "application/json"
      ]
    },
    {
      "name": "jeap.jwe.filter.problem-type-base-uri",
